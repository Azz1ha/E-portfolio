{% extends 'base.html.twig' %}

{% block title %}SAE1.02 - Portfolio{% endblock %}

{% block body %}
<style>
    body {
        background: linear-gradient(135deg, #ff69b4 0%, #ffb6d9 100%);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
    }

    .navbar {
        background-color: #ff1493 !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    .navbar-brand {
        font-weight: bold;
        font-size: 1.5em;
    }

    .nav-link {
        color: white !important;
        font-weight: 500;
        transition: all 0.3s ease;
        position: relative;
    }

    .nav-link:hover {
        color: #ffe0f0 !important;
        transform: translateX(5px);
        text-shadow: 0 0 10px rgba(255, 224, 240, 0.8), 0 0 20px rgba(255, 224, 240, 0.6);
    }

    .dropdown-menu {
        background-color: #ff1493 !important;
        border: none;
    }

    .dropdown-item {
        color: white !important;
        transition: background-color 0.3s ease;
    }

    .dropdown-item:hover {
        background-color: #ff69b4 !important;
        color: white !important;
    }

    .projet-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 50px 20px;
    }

    h1 {
        color: white;
        font-size: 3em;
        font-weight: bold;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        margin-bottom: 30px;
    }

    .projet-content {
        background: rgba(255, 255, 255, 0.1);
        padding: 40px;
        border-radius: 15px;
        max-width: 1200px;
        backdrop-filter: blur(10px);
        width: 100%;
    }

    .projet-text {
        width: 100%;
        text-align: left;
    }

    .projet-image {
        display: none;
    }

    .projet-image img {
        width: 100%;
        max-width: 280px;
        height: auto;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        border: 3px solid rgba(255, 255, 255, 0.3);
    }

    .projet-content p {
        color: white;
        font-size: 1em;
        line-height: 1.8;
        margin-bottom: 15px;
        text-align: left;
    }

    .projet-content h2 {
        color: white;
        font-size: 2em;
        margin-top: 30px;
        margin-bottom: 20px;
        border-bottom: 3px solid rgba(255, 255, 255, 0.3);
        padding-bottom: 10px;
    }

    .projet-content h3 {
        color: #ffe0f0;
        font-size: 1.3em;
        margin-top: 20px;
        margin-bottom: 10px;
        font-weight: bold;
    }

    .section-box {
        background: rgba(255, 255, 255, 0.05);
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
        border-left: 4px solid #ffb6d9;
    }

    .section-box ul {
        color: white;
        margin-left: 20px;
        line-height: 2;
    }

    .section-box li {
        margin-bottom: 10px;
    }

    .achievement-list {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        color: white;
        margin-top: 10px;
    }

    .achievement-item {
        background: rgba(255, 255, 255, 0.08);
        padding: 15px;
        border-radius: 8px;
        border-left: 3px solid #ff69b4;
    }

    .achievement-item strong {
        color: #ffe0f0;
    }

    .back-button {
        margin-top: 20px;
    }

    .back-button a {
        background-color: white;
        color: #ff1493;
        padding: 10px 30px;
        border-radius: 25px;
        text-decoration: none;
        font-weight: bold;
        transition: background-color 0.3s ease;
    }

    .back-button a:hover {
        background-color: #ffe0f0;
    }

    /* Mode sombre */
    body.dark-mode {
        background: linear-gradient(135deg, #4a1c3a 0%, #2d0f26 100%);
    }

    body.dark-mode .navbar {
        background-color: #2d0f26 !important;
    }

    body.dark-mode .projet-container h1,
    body.dark-mode .projet-content p {
        color: #e0e0e0;
    }

    body.dark-mode .projet-content h2 {
        color: #e0e0e0;
        border-bottom-color: rgba(224, 224, 224, 0.3);
    }

    body.dark-mode .projet-content h3 {
        color: #e0a8c8;
    }

    body.dark-mode .navbar-brand,
    body.dark-mode .nav-link {
        color: #e0e0e0 !important;
    }

    body.dark-mode .dropdown-menu {
        background-color: #2d0f26 !important;
    }

    body.dark-mode .dropdown-item {
        color: #e0e0e0 !important;
    }

    body.dark-mode .dropdown-item:hover {
        background-color: #4a1c3a !important;
    }

    body.dark-mode .projet-content {
        background: rgba(255, 255, 255, 0.05);
    }

    body.dark-mode .projet-image img {
        border-color: rgba(224, 224, 224, 0.3);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    }

    body.dark-mode .back-button a {
        background-color: #e0e0e0;
        color: #2d0f26;
    }

    body.dark-mode .back-button a:hover {
        background-color: #f0f0f0;
    }

    body.dark-mode .section-box {
        background: rgba(255, 255, 255, 0.08);
        border-left-color: #e0a8c8;
    }

    body.dark-mode .achievement-item {
        background: rgba(255, 255, 255, 0.1);
        border-left-color: #e0a8c8;
    }

    body.dark-mode .achievement-item strong,
    body.dark-mode .section-box strong {
        color: #e0a8c8;
    }

    body.dark-mode h3 {
        color: #e0a8c8 !important;
    }

    #theme-toggle {
        border: 2px solid rgba(255, 255, 255, 0.3);
        transition: all 0.3s ease;
    }

    #theme-toggle:hover {
        border-color: white;
        background-color: rgba(255, 255, 255, 0.1);
    }

    body.dark-mode #theme-toggle {
        border-color: rgba(224, 224, 224, 0.3);
    }

    body.dark-mode #theme-toggle:hover {
        border-color: #e0e0e0;
        background-color: rgba(224, 224, 224, 0.1);
    }

    /* Footer styles */
    footer {
        margin-top: auto;
        background-color: #ff1493 !important;
        color: white !important;
    }

    footer a {
        color: #ffe0f0 !important;
        text-decoration: none;
    }

    footer a:hover {
        color: white !important;
        text-decoration: underline;
    }

    body.dark-mode footer {
        background-color: #2d0f26 !important;
    }

    body.dark-mode footer a {
        color: #e0e0e0 !important;
    }

    body.dark-mode footer a:hover {
        color: white !important;
    }

    /* Image Gallery Styles */
    .gallery-section {
        margin-top: 30px;
        margin-bottom: 20px;
    }

    .image-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .gallery-item {
        background: rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        overflow: hidden;
        border: 2px solid rgba(255, 182, 217, 0.3);
        transition: all 0.3s ease;
    }

    .gallery-item:hover {
        transform: translateY(-5px);
        border-color: #ffb6d9;
        box-shadow: 0 8px 20px rgba(255, 20, 147, 0.2);
    }

    .gallery-item img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 8px;
        padding: 10px;
    }

    .gallery-item-caption {
        padding: 15px;
        color: white;
        font-weight: bold;
        text-align: center;
        font-size: 0.95em;
        background: rgba(0, 0, 0, 0.2);
    }

    body.dark-mode .gallery-item {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(224, 224, 224, 0.3);
    }

    body.dark-mode .gallery-item:hover {
        border-color: #e0a8c8;
        box-shadow: 0 8px 20px rgba(224, 168, 200, 0.2);
    }
</style>

<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">E-portfolio</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/">Accueil</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Projets Personnels</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="{{ path('app_projet_1') }}">Bassira</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_projet_2') }}">Solarsip</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Compétences</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="{{ path('app_competence_administrer') }}">Administrer</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_competence_connecter') }}">Connecter</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_competence_programmer') }}">Programmer</a></li>
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_cv') }}">CV</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#portfolio">Portfolio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#contact">Contact</a>
                </li>
            </ul>
            <button id="theme-toggle" class="btn btn-outline-light ms-3" title="Basculer le thème">
                <i class="fas fa-moon"></i>
            </button>
        </div>
    </div>
</nav>

<div class="projet-container">
    <h1>SAE1.02</h1>
    <div class="projet-content">
        <div class="projet-text">
            <h2>SAE1.02 - Résumé</h2>
            <p>Le contenu détaillé de cette SAE a été déplacé vers la page de compétence <strong>Programmer</strong>.</p>
            <p>Toutes les sections, les travaux réalisés, les connaissances acquises et les visuels sont désormais accessibles dans la rubrique Programmer.</p>
            <p>Cette page reste disponible comme point d'entrée, mais les détails opératoires sont maintenant regroupés dans la compétence dédiée.</p>
            <p><a href="{{ path('app_competence_programmer') }}" style="color: white; text-decoration: underline;">Voir la compétence Programmer</a></p>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const themeToggle = document.getElementById('theme-toggle');
    const body = document.body;
    const icon = themeToggle.querySelector('i');

    // Vérifier le thème sauvegardé
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark') {
        body.classList.add('dark-mode');
        icon.classList.remove('fa-moon');
        icon.classList.add('fa-sun');
    }

    // Basculer le thème
    themeToggle.addEventListener('click', function() {
        body.classList.toggle('dark-mode');

        if (body.classList.contains('dark-mode')) {
            localStorage.setItem('theme', 'dark');
            icon.classList.remove('fa-moon');
            icon.classList.add('fa-sun');
        } else {
            localStorage.setItem('theme', 'light');
            icon.classList.remove('fa-sun');
            icon.classList.add('fa-moon');
        }
    });
});
</script>
{% endblock %}